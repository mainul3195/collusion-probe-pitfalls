# Copy to env.sh, set THESIS_ROOT to this repository's checkout, then `source env.sh` before running code/run_*.sh.
export THESIS_ROOT="$PWD"
export THESIS="$THESIS_ROOT"
export HF_HOME="$THESIS_ROOT/hf_cache"
export PYTHONPATH="$THESIS_ROOT/narcbench"
export NARCBENCH_DIR="$THESIS_ROOT/narcbench"
source "$THESIS_ROOT/venv/bin/activate" 2>/dev/null
export CUDA_DEVICE_ORDER=PCI_BUS_ID
